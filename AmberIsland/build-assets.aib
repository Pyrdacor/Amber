# Sprite
// Player base sprites
@"player/sprites/0_{0}_player.aispr" <- "character_base/char_a_p1/{0}.png"
@"player/sprites/1_{0}_player.aispr" <- "character_base/char_a_pONE1/{0}.png"
@"player/sprites/2_{0}_player.aispr" <- "character_base/char_a_pONE2/{0}.png"
@"player/sprites/3_{0}_player.aispr" <- "character_base/char_a_pONE3/{0}.png"
// Outfit sprites
@"player/sprites/0_{0}_outfit.aispr" <- "character_base/char_a_p1/1out/{0}.png"
@"player/sprites/1_{0}_outfit.aispr" <- "character_base/char_a_pONE1/1out/{0}.png"
@"player/sprites/2_{0}_outfit.aispr" <- "character_base/char_a_pONE2/1out/{0}.png"
@"player/sprites/3_{0}_outfit.aispr" <- "character_base/char_a_pONE3/1out/{0}.png"
// TODO
// Hair sprites
@"player/sprites/0_{0}_hair.aispr" <- "character_base/char_a_p1/4har/{0}.png"
@"player/sprites/1_{0}_hair.aispr" <- "character_base/char_a_pONE1/4har/{0}.png"
@"player/sprites/2_{0}_hair.aispr" <- "character_base/char_a_pONE2/4har/{0}.png"
@"player/sprites/3_{0}_hair.aispr" <- "character_base/char_a_pONE3/4har/{0}.png"
// Hat sprites
@"player/sprites/0_{0}_hat.aispr" <- "character_base/char_a_p1/5hat/{0}.png"
@"player/sprites/1_{0}_hat.aispr" <- "character_base/char_a_pONE1/5hat/{0}.png"
@"player/sprites/2_{0}_hat.aispr" <- "character_base/char_a_pONE2/5hat/{0}.png"
@"player/sprites/3_{0}_hat.aispr" <- "character_base/char_a_pONE3/5hat/{0}.png"
// Primary tool sprites
@"player/sprites/1_{0}_primarytool.aispr" <- "character_base/char_a_pONE1/6tla/{0}.png"
@"player/sprites/2_{0}_primarytool.aispr" <- "character_base/char_a_pONE2/6tla/{0}.png"
@"player/sprites/3_{0}_primarytool.aispr" <- "character_base/char_a_pONE3/6tla/{0}.png"
// Secondary tool sprites
@"player/sprites/1_{0}_secondarytool.aispr" <- "character_base/char_a_pONE1/7tlb/{0}.png"
@"player/sprites/2_{0}_secondarytool.aispr" <- "character_base/char_a_pONE2/7tlb/{0}.png"
@"player/sprites/3_{0}_secondarytool.aispr" <- "character_base/char_a_pONE3/7tlb/{0}.png"

# PlayerSpriteSheetDefinition
// "State", {SpriteFilePrefix, OffsetXInFrames, OffsetYInFrames, FrameIndices ...}
@"player/def/player_idle.aipssd" <- "Idle", [0, 0, 0, 0]
@"player/def/player_pushing.aipssd" <- "Pushing", [0, 1, 0, 0-1]
@"player/def/player_pulling.aipssd" <- "Pulling", [0, 3, 0, 0-1]
@"player/def/player_jumping.aipssd" <- "Jumping", [0, 5, 0, 0-2]
@"player/def/player_walking.aipssd" <- "Walking", [0, 0, 4, 0-5]
@"player/def/player_running.aipssd" <- "Running", [0, 0, 4, 0-1, 6, 3-4, 7]
@"player/def/player_dodging.aipssd" <- "Dodging", [1, 4, 0, 0]
@"player/def/player_receivingdamage.aipssd" <- "ReceivingDamage", [1, 5, 0, 0]
@"player/def/player_die.aipssd" <- "Die", [1, 6, 0, 0-1]
@"player/def/player_idlewithweapon.aipssd" <- "IdleWithWeapon", [2, 0, 0, 0-3]
@"player/def/player_blocking.aipssd" <- "Blocking", [2, 0, 4, 0]
@"player/def/player_jumpingforward.aipssd" <- "JumpingForward", [2, 2, 4, 0]
@"player/def/player_swingingforth.aipssd" <- "SwingingForth", [3, 0, 0, 0-3]
@"player/def/player_swingingback.aipssd" <- "SwingingBack", [3, 4, 0, 0-3]
@"player/def/player_stabbing.aipssd" <- "Stabbing", [3, 0, 4, 0-3]
@"player/def/player_shieldattacking.aipssd" <- "ShieldAttacking", [3, 4, 4, 0-3]

# MergePlayerSpriteSheetDefinitions
@"player/player_ssd.aipssd" <- "player/def/player_*.aipssd"

# PlayerSpriteSheet
// Args: Sprites, SpriteSheetDefinition, [FrameWidth, FrameHeight]
@"player/pss/001_player.aipss" <- "player/sprites/*_player.aispr", "player/player_ssd.aipssd", [64, 64]
@"player/pss/002_outfit.aipss" <- "player/sprites/*_outfit.aispr", "player/player_ssd.aipssd", [64, 64]
// TODO...
@"player/pss/005_hair.aipss" <- "player/sprites/*_hair.aispr", "player/player_ssd.aipssd", [64, 64]
@"player/pss/006_hat.aipss" <- "player/sprites/*_hat.aispr", "player/player_ssd.aipssd", [64, 64]
@"player/pss/007_primarytool.aipss" <- "player/sprites/*_primarytool.aispr", "player/player_ssd.aipssd", [64, 64]
@"player/pss/008_secondarytool.aipss" <- "player/sprites/*_secondarytool.aispr", "player/player_ssd.aipssd", [64, 64]

// Build map sprite sheets
# MapSpriteSheet
// Monsters
@"monsters/mss/001_mon.aimss" <- "mon_sprites.aic"[1,2], {1:0,2:0}

// Build font sprites
# FontSprite
@"fonts/{0}.aispr" <- "fonts/{0}.png"

// Build fonts
# Font
@"fonts/{0}.aifont" <- "fonts/{0}.aispr"

// Build file containers (last)
# Container
"mon_data.aic" <- "monsters/data/*.aid"
"mon_sprites.aic" <- "monsters/sprites/*.aispr"
@"monsters/{0}_animations.aic" <- "monsters/animations/{0}/*.aianim"
"mon_anim.aic" <- "monsters/*_animations.aic"
"mon_mss.aic" <- "monsters/mss/*.aimss"
"map.aic" <- "maps/*.aimap"
"tileset.aic" <- "tilesets/*.aitileset"
"tileatlas.aic" <- "tilesets/*.aispr"
"fonts.aic" <- "fonts/*.aifont"
"player.aic" <- "player/pss/*.aipss"